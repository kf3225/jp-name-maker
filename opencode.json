{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "issue-planner": {
      "description": "issueを読み、縦剖断の実装計画を立案する（読み取り専用）。",
      "mode": "subagent",
      "prompt": "{file:./.agents/agents/issue-planner.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "cat *": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "git *": "allow",
          "gh *": "allow"
        }
      }
    },
    "plan-reviewer": {
      "description": "実装計画を審査し OK/CHANGES_REQUESTED を返す（読み取り専用・最大3往復）。",
      "mode": "subagent",
      "prompt": "{file:./.agents/agents/plan-reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "cat *": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "git *": "allow",
          "gh *": "allow"
        }
      }
    },
    "implementer": {
      "description": "承認された計画を git worktree で実装する（関数型/OCP）。vp check/test/build をGreenにしてコミット。",
      "mode": "subagent",
      "prompt": "{file:./.agents/agents/implementer.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "rg *": "allow",
          "npm *": "allow",
          "pnpm *": "allow",
          "vp *": "allow",
          "git *": "allow"
        }
      }
    },
    "impl-reviewer": {
      "description": "実装差分をパフォーマンス/セキュリティ最重視で審査し OK/CHANGES_REQUESTED を返す（読み取り専用・最大3往復）。",
      "mode": "subagent",
      "prompt": "{file:./.agents/agents/impl-reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "cat *": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "git *": "allow",
          "gh *": "allow"
        }
      }
    },
    "pr-author": {
      "description": "worktreeのブランチをpushし、PRテンプレートでPull Requestを作成する。",
      "mode": "subagent",
      "prompt": "{file:./.agents/agents/pr-author.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "gh *": "allow",
          "git *": "allow"
        }
      }
    }
  }
}
